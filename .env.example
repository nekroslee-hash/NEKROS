NEKROS_API_TOKEN=replace-with-a-long-random-secret
NEKROS_DATABASE_PATH=nekros.db

# Optional OpenRouter connection. Keep the key in .env only; never commit it.
NEKROS_OPENROUTER_API_KEY=
NEKROS_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Comma-separated model IDs. Only model IDs ending in :free are accepted.
NEKROS_FREE_MODELS=

# Reserved for future official free media API adapters.
NEKROS_MEDIA_PROVIDERS=
